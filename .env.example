# Copia este archivo como .env y pega tu clave de Google AI Studio.
GEMINI_API_KEY=tu_clave_api_aqui
# Opcional: el modelo predeterminado es gemini-3.5-flash-lite (baja latencia).
# GEMINI_MODEL=gemini-3.5-flash-lite
# Si el principal está saturado (503), se prueba este modelo estable alternativo.
# GEMINI_FALLBACK_MODEL=gemini-3.6-flash
